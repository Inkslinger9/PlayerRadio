<Project Sdk="Microsoft.NET.Sdk">
  <!-- Optional local settings (your GameDir). Not committed. -->
  <Import Project="$(MSBuildThisFileDirectory)GameDir.props" Condition="Exists('$(MSBuildThisFileDirectory)GameDir.props')" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PlayerRadio</AssemblyName>
    <RootNamespace>PlayerRadio</RootNamespace>
    <Version>0.2.3</Version>
    <Authors>Inkslinger</Authors>
    <Product>Player Radio</Product>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Reference locations (see "Building" in README.md). Set GameDir to your PEAK install, either
         - in a GameDir.props file next to this csproj (git-ignored; copy GameDir.props.example), or
         - on the command line: dotnet build -c Release -p:GameDir="D:\SteamLibrary\steamapps\common\PEAK"
         If GameDir is not set, the default Steam location is used when it exists. -->
    <GameDir Condition="'$(GameDir)' == '' And Exists('C:\Program Files (x86)\Steam\steamapps\common\PEAK\PEAK_Data\Managed')">C:\Program Files (x86)\Steam\steamapps\common\PEAK</GameDir>
    <ManagedDir Condition="'$(ManagedDir)' == '' And '$(GameDir)' != ''">$(GameDir)\PEAK_Data\Managed</ManagedDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == '' And '$(GameDir)' != ''">$(GameDir)\BepInEx\core</BepInExCoreDir>
    <!-- Fallback layout for builds without a game install: game assemblies in ../Managed, BepInEx.dll and 0Harmony.dll in lib/ (both git-ignored). -->
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(MSBuildThisFileDirectory)../Managed</ManagedDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(MSBuildThisFileDirectory)lib</BepInExCoreDir>
    <!-- Unity's netstandard facades vs. SDK ref pack: prefer the SDK one -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <!-- AI disclosure, as asked for by Thunderstore (https://wiki.thunderstore.io, "LLMs and AI-generated files"). -->
  <ItemGroup>
    <AssemblyMetadata Include="AI_Assisted_Creation" Value="true" />
    <AssemblyMetadata Include="AI_Model_Vendor" Value="Grok Bot" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="thunderstore/**" />
    <None Remove="thunderstore/**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExCoreDir)/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCoreDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

